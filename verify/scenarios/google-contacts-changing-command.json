{
  "schema": "verify-scenario/1",
  "feature": "google-contacts-changing-command",
  "steps": [
    {
      "name": "first-run",
      "argv": [
        "apply",
        "--plan",
        "{scratch}/plan-c1.json",
        "--seal",
        "sha256:ec2db81297b256fb7446dabc2a96d722712e7dc5ae0e388440cda034cd64999b",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "google-contacts.apply",
          "causeCode": "SUCCESS_COMPLETED",
          "transactionState": "completed",
          "effects.completed": ["contacts.mutate"],
          "data.targetCount": 1
        }
      }
    },
    {
      "name": "second-run-drift",
      "argv": [
        "apply",
        "--plan",
        "{scratch}/plan-c1.json",
        "--seal",
        "sha256:ec2db81297b256fb7446dabc2a96d722712e7dc5ae0e388440cda034cd64999b",
        "--json"
      ],
      "expect": {
        "exitCode": 3,
        "stderr": "",
        "result": {
          "commandIdentity": "google-contacts.apply",
          "causeCode": "DOMAIN_CONTACTS_REVISION_DRIFT",
          "transactionState": "unchanged"
        }
      }
    },
    {
      "name": "nothing-pending",
      "argv": ["pending", "--json"],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "google-contacts.pending",
          "causeCode": "SUCCESS_UNCHANGED",
          "data.unfinished.length": 0
        }
      }
    },
    {
      "name": "interrupted-run",
      "timeoutMilliseconds": 2500,
      "argv": [
        "apply",
        "--plan",
        "{scratch}/plan-hang.json",
        "--seal",
        "sha256:388a08dccbb96f9f9214d92d219e4b4117bec027959a9fb5643dd842bf88ee65",
        "--json"
      ],
      "expect": {
        "exitCode": 143,
        "timedOut": true,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "interruption-blocks",
      "argv": [
        "apply",
        "--plan",
        "{scratch}/plan-hang.json",
        "--seal",
        "sha256:388a08dccbb96f9f9214d92d219e4b4117bec027959a9fb5643dd842bf88ee65",
        "--json"
      ],
      "expect": {
        "exitCode": 3,
        "stderr": "",
        "result": {
          "commandIdentity": "google-contacts.apply",
          "causeCode": "DOMAIN_CONTACTS_APPLY_UNRESOLVED",
          "transactionState": "unchanged"
        }
      }
    },
    {
      "name": "interruption-is-listed",
      "argv": ["pending", "--json"],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "google-contacts.pending",
          "causeCode": "SUCCESS_UNCHANGED",
          "data.unfinished.length": 1,
          "data.unfinished.0.commandIdentity": "google-contacts.apply",
          "data.unfinished.0.targets.0": "owner@example.com:people/c-hang"
        }
      }
    },
    {
      "name": "interruption-is-narrow",
      "argv": [
        "apply",
        "--plan",
        "{scratch}/plan-c2.json",
        "--seal",
        "sha256:d1f7ff82bc99baebbe0a0b0be58262072efa26bd2dcd183378e0477679dab73c",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "google-contacts.apply",
          "causeCode": "SUCCESS_COMPLETED",
          "transactionState": "completed",
          "data.targetCount": 1
        }
      }
    }
  ]
}
